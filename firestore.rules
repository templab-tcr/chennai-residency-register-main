rules_version = '2';

// The web pages never read or write Firestore directly.
// All writes come from Apps Script (Code.gs) using a service account, which bypasses these rules.
// Keeping everything closed means guest records cannot be read or changed from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
